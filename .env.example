# Polymarket Configuration
POLYGON_WALLET_PRIVATE_KEY=your_private_key_here
POLYGON_WALLET_ADDRESS=your_wallet_address_here

# Polymarket API
POLYMARKET_API_KEY=your_polymarket_api_key_here
POLYMARKET_API_SECRET=your_polymarket_api_secret_here
POLYMARKET_PASSPHRASE=your_passphrase_here

# AI/LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7

# News Sources
NEWSAPI_KEY=your_newsapi_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Twitter/X API (for social sentiment)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=

# Database Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma
POSTGRES_URL=postgresql://user:password@localhost:5432/polybet

# Trading Configuration
PAPER_TRADING_MODE=true
MAX_BET_SIZE_PCT=0.03
MAX_DAILY_LOSS_PCT=0.10
MIN_EDGE_REQUIRED=0.05
MIN_CONFIDENCE_SCORE=6

# Risk Management
KELLY_FRACTION=0.25
MAX_CONCURRENT_POSITIONS=10
CIRCUIT_BREAKER_ENABLED=true

# Monitoring & Logging
LOG_LEVEL=INFO
SENTRY_DSN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# System Configuration
SCRAPE_INTERVAL_MINUTES=15
TRADING_CYCLE_INTERVAL_MINUTES=30
API_RATE_LIMIT_CALLS_PER_MINUTE=60
